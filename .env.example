# ── Claude (gera o texto dos posts) ──
# platform.claude.com -> API keys
ANTHROPIC_API_KEY=sk-ant-...

# ── X / Twitter — API oficial ──
# developer.x.com -> Projects & Apps -> seu app
# O app precisa de "User authentication settings" com permissao: Read and write
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── Gatilho externo (opcional, recomendado no plano Free do Render) ──
# Qualquer texto longo e aleatorio. Protege /api/posts/cron
CRON_TOKEN=

# ── Onde guardar config e historico ──
# Em /tmp o estado se perde a cada restart. Se voce anexar um disco
# persistente no Render, aponte para o mount path dele (ex: /var/data)
DATA_DIR=/tmp
